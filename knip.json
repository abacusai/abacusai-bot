{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/main/window-chrome.e2e-entry.ts",
        "src/main/rpc/transports/rpc-handshake.e2e-main.ts",
        "src/preload/index.ts",
        "src/**/*.test.{ts,tsx}",
        "scripts/before-pack.cjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{js,mjs,cjs}",
        "*.config.ts"
      ],
      "ignore": [],
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["@abacus-ai/web"],
      "paths": {
        "ort-dist/*": ["../../node_modules/onnxruntime-web/dist/*"]
      }
    },
    "apps/web": {
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "tailwindcss",
        "tw-animate-css",
        "shadcn"
      ],
      "paths": {
        "ort-dist/*": ["../../node_modules/onnxruntime-web/dist/*"]
      },
      "entry": [
        "src/{main,notch}.tsx",
        "src/routes/**/*.tsx",
        "src/notch-routes/**/*.tsx",
        "src/test-support/notch-fit.tsx",
        "src/**/*.test.{ts,tsx}",
        "src/platform/*.{ts,tsx}",
        "*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,mjs}", "*.ts"],
      "ignore": ["src/ui/**"]
    },
    "packages/contract": {
      "entry": [
        "src/**/*.test.ts",
        "src/*.ts!",
        "src/contract/**/*.ts!",
        "src/transcript/*.ts!"
      ],
      "project": ["src/**/*.ts"],
      "ignoreExportsUsedInFile": true
    },
    "apps/host": {
      "entry": ["src/**/*.test.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "scripts/*.mjs", "*.config.ts"],
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": [
        "@abacus-ai/connectors",
        "@abacus-ai/updater",
        "extract-zip",
        "pptxgenjs",
        "qrcode",
        "tuf-js",
        "@abacus-ai/config"
      ]
    }
  },
  "tags": ["-public"]
}
