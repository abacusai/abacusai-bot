{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/main/window-chrome.e2e-entry.ts",
        "src/main/rpc/transports/rpc-handshake.e2e-main.ts",
        "src/preload/index.ts",
        "src/**/*.test.{ts,tsx}",
        "scripts/before-pack.cjs",
        "scripts/build-experience.js",
        "scripts/check-chat-bundle.mjs",
        "scripts/check-jsx-i18n.js",
        "scripts/check-packaged-resources.js",
        "scripts/check-react-compiler.mjs",
        "scripts/check-release-build.mjs",
        "scripts/check-release-versions.mjs",
        "scripts/download-llama-server.js",
        "scripts/download-scrcpy.js",
        "scripts/download-wa-js.js",
        "scripts/generate-notices.js",
        "scripts/generate-routes.mjs",
        "scripts/measure-release-size.mjs",
        "scripts/rpc-ws-smoke.mjs",
        "scripts/screenshots.mjs",
        "scripts/shadcn-registry-snapshot.mjs",
        "scripts/sync-chat-fixtures.mjs",
        "scripts/sync-locales.js"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{js,mjs,cjs}",
        "*.config.ts",
        "vite.shared.ts"
      ],
      "ignore": [],
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["@abacus-ai/web"],
      "paths": {
        "ort-dist/*": ["../../node_modules/onnxruntime-web/dist/*"]
      }
    },
    "apps/web": {
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": [
        "@testing-library/dom",
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "tailwindcss",
        "tw-animate-css",
        "shadcn",
        "@tanstack/router-generator"
      ],
      "paths": {
        "ort-dist/*": ["../../node_modules/onnxruntime-web/dist/*"]
      },
      "entry": [
        "src/{main,notch}.tsx",
        "src/routes/**/*.tsx",
        "src/notch-routes/**/*.tsx",
        "src/test-support/notch-fit.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignore": [
        "src/routeTree.gen.ts",
        "src/notchRouteTree.gen.ts",
        "src/ui/**"
      ]
    },
    "packages/contract": {
      "entry": [
        "src/**/*.test.ts",
        "src/*.ts!",
        "src/contract/**/*.ts!",
        "src/transcript/*.ts!"
      ],
      "project": ["src/**/*.ts"],
      "ignoreExportsUsedInFile": true
    }
  },
  "tags": ["-public"]
}
