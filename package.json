{
  "name": "abacusai-bot",
  "version": "1.0.86",
  "private": true,
  "description": "AbacusAI Bot: free, open-source personal agents for your messaging apps, tools and services.",
  "homepage": "https://github.com/abacusai/abacusai-bot",
  "license": "MIT",
  "author": "Abacus.AI, Inc. <support@abacus.ai>",
  "type": "module",
  "scripts": {
    "build": "turbo run build vendor",
    "changelog": "node scripts/sync-changelog.js",
    "check": "turbo run format:check lint typecheck build vendor check:i18n check:locales check:audit check:licenses check:knip check:scripts check:ui-registry && turbo run test --concurrency=1",
    "check:audit": "node scripts/check-audit.js",
    "dev": "pnpm run dev:desktop",
    "dev:desktop": "turbo run dev --filter=@abacus-ai/desktop",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:all": "oxlint --config packages/config/oxlint/all.ts .",
    "lint:fix": "oxlint --fix .",
    "package": "turbo run package",
    "test": "turbo run build vendor && turbo run test --concurrency=1",
    "test:coverage": "turbo run test:coverage",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check:knip": "knip --workspace apps/desktop --workspace apps/host --workspace apps/web --workspace packages/contract --include files,exports,types,duplicates,dependencies,unlisted",
    "smoke:rpc": "pnpm --filter @abacus-ai/desktop smoke:rpc",
    "check:scripts": "node --test scripts/web-split.test.mjs scripts/agui-smoke.test.mjs scripts/build-provenance.test.mjs apps/desktop/scripts/check-release-build.test.mjs",
    "generate:licenses": "node apps/desktop/scripts/generate-notices.js --graph",
    "check:licenses": "node --test apps/desktop/scripts/license-data.test.mjs && node apps/desktop/scripts/generate-notices.js --graph",
    "prepare": "lefthook install",
    "gitleaks": "node -e \"const r = require('node:module').createRequire(require.resolve('@nogoo9/gitleaks')); const platform = process.platform === 'win32' ? 'windows' : process.platform; const binary = r.resolve('@nogoo9/gitleaks-' + platform + '-' + process.arch + '/bin/gitleaks' + (platform === 'windows' ? '.exe' : '')); process.exit(require('node:child_process').spawnSync(binary, process.argv.slice(1), {stdio: 'inherit'}).status ?? 1)\" --"
  },
  "devDependencies": {
    "@abacus-ai/config": "workspace:*",
    "@nogoo9/gitleaks": "8.30.1-post.2",
    "@size-limit/file": "^14.1.0",
    "@types/node": "catalog:",
    "jiti": "2.7.0",
    "knip": "6.38.0",
    "lefthook": "2.1.10",
    "oxc-parser": "0.150.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "size-limit": "^14.1.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
