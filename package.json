{
  "name": "abacusai-bot",
  "version": "1.0.86",
  "private": true,
  "description": "AbacusAI Bot: free, open-source personal agents for your messaging apps, tools and services.",
  "homepage": "https://github.com/abacusai/abacusai-bot",
  "license": "MIT",
  "author": "Abacus.AI, Inc. <support@abacus.ai>",
  "type": "module",
  "scripts": {
    "build": "turbo run build vendor",
    "changelog": "node scripts/sync-changelog.js",
    "check": "turbo run format:check lint typecheck test check:i18n check:locales check:audit check:knip check:web-split check:ui-registry --concurrency=1",
    "check:audit": "node scripts/check-audit.js",
    "dev": "pnpm run dev:desktop",
    "dev:desktop": "turbo run dev --filter=@abacus-ai/desktop",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:all": "oxlint --config packages/config/oxlint/all.ts .",
    "lint:fix": "oxlint --fix .",
    "package": "turbo run package",
    "test": "turbo run test --concurrency=1",
    "test:coverage": "turbo run test:coverage",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check:knip": "knip --workspace apps/desktop --workspace apps/web --workspace packages/contract --include files,exports,types,duplicates,dependencies,unlisted",
    "smoke:rpc": "pnpm --filter @abacus-ai/desktop smoke:rpc",
    "check:web-split": "node --test scripts/web-split.test.mjs scripts/cutover/knip-canaries.test.mjs scripts/cutover/check-deletions.test.mjs scripts/cutover/parity-consumers.test.mjs apps/desktop/scripts/check-release-build.test.mjs"
  },
  "devDependencies": {
    "@abacus-ai/config": "workspace:*",
    "@size-limit/file": "^14.1.0",
    "@types/node": "catalog:",
    "jiti": "2.7.0",
    "knip": "6.38.0",
    "oxc-parser": "0.150.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "size-limit": "^14.1.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
