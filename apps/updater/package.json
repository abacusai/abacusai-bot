{
  "name": "@abacus-ai/updater",
  "version": "0.0.0",
  "private": true,
  "description": "The experience builder, change classifier, and read-only TUF update repository service.",
  "type": "module",
  "exports": {
    "./classify": {
      "types": "./dist/classify.d.mts",
      "default": "./dist/classify.mjs"
    },
    "./experience": {
      "types": "./dist/experience.d.mts",
      "default": "./dist/experience.mjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.mts",
      "default": "./dist/manifest.mjs"
    },
    "./repository": {
      "types": "./dist/repository.d.mts",
      "default": "./dist/repository.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "preview:repo": "node dist/server.mjs",
    "publish:dev": "node dist/publish.mjs",
    "refresh:dev": "node dist/refresh.mjs",
    "serve:dev": "node dist/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@tufjs/canonical-json": "2.0.0",
    "@tufjs/models": "5.0.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@abacus-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/yazl": "2.4.6",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
