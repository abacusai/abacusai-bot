{
  "extends": "@abacus-ai/config/typescript/node",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    "strictNullChecks": false,
    "noImplicitOverride": false,
    "noImplicitAny": false,
    "composite": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/desktop.preload.tsbuildinfo"
  },
  "include": ["src/preload", "src/shared"]
}
