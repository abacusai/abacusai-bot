{
  "name": "@abacus-ai/desktop",
  "version": "1.0.86",
  "private": true,
  "description": "AbacusAI Bot: free, open-source personal agents for your messaging apps, tools and services.",
  "homepage": "https://github.com/abacusai/abacusai-bot",
  "license": "MIT",
  "author": "Abacus.AI, Inc. <support@abacus.ai>",
  "type": "module",
  "main": "dist/main/index.js",
  "imports": {
    "#main/*": [
      "./src/main/*.ts",
      "./src/main/*/index.ts",
      "./src/main/*"
    ],
    "#preload/*": [
      "./src/preload/*.ts",
      "./src/preload/*/index.ts",
      "./src/preload/*"
    ]
  },
  "scripts": {
    "build": "node scripts/generate-notices.js --graph && vite build",
    "check:react-compiler": "node scripts/check-react-compiler.mjs",
    "check:packaged": "node scripts/check-packaged-resources.js",
    "check:ui-registry": "node --test scripts/shadcn-registry-proxy.test.mjs && node scripts/shadcn-registry-snapshot.mjs --check",
    "dev": "node scripts/generate-notices.js --graph && vite",
    "experience": "node scripts/build-experience.js",
    "package": "electron-builder --config electron-builder.yml",
    "package:dir": "electron-builder --config electron-builder.yml --dir",
    "package:linux": "electron-builder --config electron-builder.yml --linux",
    "package:mac": "electron-builder --config electron-builder.yml --mac",
    "package:win": "electron-builder --config electron-builder.yml --win",
    "start": "electron .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project main --project preload",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "vendor": "node scripts/download-scrcpy.js && node scripts/download-wa-js.js && node scripts/download-llama-server.js",
    "dev:fixtures": "node scripts/generate-notices.js --graph && VITE_NEXT_DB_FIXTURES=1 vite",
    "screenshots": "node scripts/screenshots.mjs",
    "check:release": "node scripts/check-release-build.mjs",
    "check:release-versions": "node scripts/check-release-versions.mjs",
    "generate:notices": "node scripts/generate-notices.js",
    "check:chat-bundle": "node scripts/check-chat-bundle.mjs",
    "measure:size": "node scripts/measure-release-size.mjs",
    "smoke:rpc": "node scripts/rpc-ws-smoke.mjs",
    "ui:add": "shadcn add",
    "ui:audit": "node scripts/ui-audit-capture.mjs"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.9.6",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@orpc/client": "1.15.4",
    "@orpc/contract": "1.15.4",
    "@orpc/server": "1.15.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "1.5.4",
    "tuf-js": "^6.0.0",
    "valibot": "1.5.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@abacus-ai/agent": "workspace:*",
    "@abacus-ai/config": "workspace:*",
    "@abacus-ai/connectors": "workspace:*",
    "@abacus-ai/contract": "workspace:*",
    "@abacus-ai/test-support": "workspace:*",
    "@abacus-ai/updater": "workspace:*",
    "@abacus-ai/web": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tanstack/ai": "0.63.0",
    "@tanstack/ai-client": "0.36.0",
    "@tanstack/db": "0.9.2",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "4.13.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "es-module-lexer": "2.3.2",
    "ghostty-web": "0.4.0",
    "jsdom": "^30.0.1",
    "oxc-parser": "0.150.0",
    "rolldown": "1.2.4",
    "spdx-license-list": "^6.12.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "catalog:",
    "zod": "3.25.76"
  }
}
