{
  "extends": "@abacus-ai/config/typescript/react",
  "compilerOptions": {
    // No `electron` and no `node`: the new renderer reaches main only through
    // its Transport, so neither may type-check here.
    "types": [],
    "strictNullChecks": true,
    "noImplicitOverride": false,
    "composite": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/desktop.renderer-next.tsbuildinfo"
  },
  "include": ["src/renderer-next", "src/shared"],
  // Shared tests run under Node and are checked by the other projects.
  "exclude": ["src/shared/**/*.test.ts"]
}
