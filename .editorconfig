# What every editor reads without a plugin. oxfmt owns the finer points; this
# keeps the surfaces it does not format (yml, sh, generated viewers) consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
