{
  "name": "@abacus-ai/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, oxlint and oxfmt configuration for every package in this repository.",
  "type": "module",
  "exports": {
    "./typescript/base": "./typescript/base.json",
    "./typescript/node": "./typescript/node.json",
    "./typescript/bundler": "./typescript/bundler.json",
    "./typescript/react": "./typescript/react.json",
    "./oxlint/base": "./oxlint/base.ts",
    "./oxlint/node": "./oxlint/node.ts",
    "./oxfmt/base": "./oxfmt/base.ts",
    "./native-packages": "./native-packages.ts",
    "./build-output-ignores": "./build-output-ignores.ts",
    "./oxlint/all": "./oxlint/all.ts",
    "./vendor-fetch": {
      "types": "./vendor-fetch.d.ts",
      "default": "./vendor-fetch.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "ultracite": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
