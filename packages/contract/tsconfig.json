{
  "extends": "@abacus-ai/config/typescript/bundler",
  "compilerOptions": {
    "composite": true,
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/contract.tsbuildinfo",
    "paths": {
      "@abacus-ai/contract/*": ["./src/*"]
    },
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
