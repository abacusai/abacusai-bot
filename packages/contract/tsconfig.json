{
  "extends": "@abacus-ai/config/typescript/bundler",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noImplicitOverride": false,
    "tsBuildInfoFile": "../../node_modules/.tmp/contract.tsbuildinfo",
    "paths": {
      "@abacus-ai/contract/*": ["./src/*"]
    },
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
