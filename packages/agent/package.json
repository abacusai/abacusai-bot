{
  "name": "@abacus-ai/agent",
  "version": "1.0.1",
  "private": true,
  "description": "The private agent process used by the AbacusAI Bot desktop app.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./usage": {
      "types": "./dist/usage-stats.d.ts",
      "default": "./dist/usage-stats.js"
    },
    "./custom-instructions": {
      "types": "./dist/custom-instructions.d.ts",
      "default": "./dist/custom-instructions.js"
    },
    "./posix-shell-install": {
      "types": "./dist/posix-shell-install.d.ts",
      "default": "./dist/posix-shell-install.js"
    },
    "./model-catalog": {
      "types": "./dist/model-catalog.d.ts",
      "default": "./dist/model-catalog.js"
    },
    "./atomic-file": {
      "types": "./dist/atomic-file.d.ts",
      "default": "./dist/atomic-file.js"
    },
    "./sandbox-support": {
      "types": "./dist/sandbox-support.d.ts",
      "default": "./dist/sandbox-support.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./tool-display": {
      "types": "./dist/tool-display.d.ts",
      "default": "./dist/tool-display.js"
    },
    "./phone-bubbles": {
      "types": "./dist/phone/phone-bubbles.d.ts",
      "default": "./dist/phone/phone-bubbles.js"
    },
    "./phone-nudges": {
      "types": "./dist/phone/phone-nudges.d.ts",
      "default": "./dist/phone/phone-nudges.js"
    },
    "./send-media": {
      "types": "./dist/send-media.d.ts",
      "default": "./dist/send-media.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    },
    "./secret-paths": {
      "types": "./dist/sandbox/secrets.d.ts",
      "default": "./dist/sandbox/secrets.js"
    },
    "./tool-policy": {
      "types": "./dist/tool-policy.d.ts",
      "default": "./dist/tool-policy.js"
    },
    "./traveler-store": {
      "types": "./dist/traveler/traveler-store.d.ts",
      "default": "./dist/traveler/traveler-store.js"
    },
    "./package.json": "./package.json",
    "./user-text": {
      "types": "./dist/user-text.d.ts",
      "default": "./dist/user-text.js"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/write-runtime-package.js",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "vendor": "node scripts/download-tools.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.76",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/napi": "^0.45.1"
  },
  "devDependencies": {
    "@abacus-ai/config": "workspace:*",
    "@abacus-ai/connectors": "workspace:*",
    "@abacus-ai/test-support": "workspace:*",
    "@ag-ui/core": "1.0.0",
    "@anthropic-ai/sdk": "^0.117.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@tanstack/ai": "~0.63.0",
    "@tanstack/ai-client": "~0.36.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typebox": "^1.3.16",
    "typescript": "catalog:",
    "undici": "^7.29.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
