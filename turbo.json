{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "ABACUSAI_BOT_DEBUG_PORT",
    "ABACUSAI_BOT_ABACUS_HOST",
    "ABACUSAI_BOT_LOG_SYNC_URL",
    "ABACUSAI_BOT_DEBUG_SYNC_URL",
    "ABACUSAI_BOT_DIAGNOSTICS_SYNC_URL",
    "CI",
    "HOME",
    "LOCALAPPDATA",
    "TMPDIR",
    "TMP",
    "TEMP",
    "DISPLAY",
    "XAUTHORITY",
    "DBUS_SESSION_BUS_ADDRESS",
    "ABACUSBOT_REQUIRE_ELECTRON_SUITES"
  ],
  "tasks": {
    "//#format": {
      "cache": false
    },
    "//#format:check": {
      "dependsOn": ["@abacus-ai/web#generate:routes"],
      "cache": false
    },
    "//#lint": {
      "dependsOn": ["//#typecheck:tools", "@abacus-ai/web#generate:routes"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    },
    "check:i18n": {},
    "check:locales": {},
    "//#check:audit": {
      "cache": false
    },
    "check:ui-registry": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "^vendor", "vendor"],
      "cache": false,
      "persistent": true
    },
    "package": {
      "dependsOn": ["build", "^vendor", "vendor"],
      "outputs": ["release/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "build", "vendor"]
    },
    "test:unit": {
      "dependsOn": ["^build", "build", "vendor"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build", "vendor"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "vendor": {
      "outputs": ["vendor/**", "resources/vendor/**"]
    },
    "//#typecheck:tools": {},
    "@abacus-ai/desktop#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": [
        "ABACUS_BUILD_COMMIT",
        "ABACUS_RELEASE",
        "VITE_UI_GALLERY",
        "VITE_NEXT_DB_FIXTURES",
        "VITE_CONNECT_SRC"
      ]
    },
    "@abacus-ai/agent#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": [
        "ABACUS_BUILD_COMMIT",
        "ABACUS_RELEASE",
        "VITE_UI_GALLERY",
        "VITE_NEXT_DB_FIXTURES"
      ]
    },
    "@abacus-ai/web#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", "build-metadata/**"],
      "env": [
        "ABACUS_WEB_OVERLAY",
        "VITE_CONNECT_SRC",
        "VITE_UI_GALLERY",
        "VITE_NEXT_DB_FIXTURES"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-provenance.mjs",
        "$TURBO_ROOT$/CHANGELOG.md"
      ]
    },
    "@abacus-ai/web#generate:routes": {
      "cache": false
    },
    "@abacus-ai/web#typecheck": {
      "dependsOn": ["^typecheck", "^build", "generate:routes"]
    },
    "@abacus-ai/web#check:i18n": {
      "dependsOn": ["generate:routes"]
    },
    "@abacus-ai/web#check:locales": {
      "dependsOn": ["generate:routes"]
    },
    "//#check:knip": {
      "dependsOn": ["@abacus-ai/web#generate:routes"],
      "cache": false
    },
    "//#check:scripts": {
      "cache": false
    },
    "@abacus-ai/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-provenance.mjs",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/docs/rewrite/specs/06-onboarding-tour-notch.md",
        "$TURBO_ROOT$/packages/contract/src/**",
        "$TURBO_ROOT$/packages/agent/src/**",
        "$TURBO_ROOT$/apps/desktop/src/main/**",
        "$TURBO_ROOT$/apps/desktop/scripts/rpc-ws-smoke.mjs",
        "$TURBO_ROOT$/apps/desktop/build/icons/32x32.png"
      ]
    },
    "@abacus-ai/desktop#dev": {
      "dependsOn": ["@abacus-ai/agent#build", "@abacus-ai/desktop#vendor"],
      "cache": false,
      "persistent": true
    },
    "@abacus-ai/host#typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/main/**",
        "$TURBO_ROOT$/apps/desktop/src/preload/*.d.ts",
        "$TURBO_ROOT$/apps/desktop/tsconfig.main.json"
      ]
    },
    "@abacus-ai/host#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/desktop/src/main/**"]
    },
    "@abacus-ai/host#test": {
      "dependsOn": ["^build", "build", "vendor"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/desktop/src/main/**"]
    }
  },
  "globalEnv": ["ABACUS_BUILD_COMMIT", "ABACUS_RELEASE"]
}
